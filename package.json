  "type": "module",
  "version": "1.0.0",
  "description": "Production-ready blog API with authentication",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
